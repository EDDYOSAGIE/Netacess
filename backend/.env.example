# Copy to .env and edit
# Local-development defaults only. See README.md before deploying.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TRUST_X_FORWARDED_PROTO=false
# SQLite for now. For Supabase use the pooled connection string, e.g.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///db.sqlite3
# Local no-Redis mode uses DatabaseCache and runs Celery tasks inline.
USE_REDIS=false
REDIS_URL=
# 32-byte urlsafe base64 key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ACCESS_CODE_ENC_KEY=
# SMS: use console only for local development. Demo/staging should set an allowlist.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=dnd
SMS_ALLOWLIST=
DEMO_MODE=false
# Required when DEMO_MODE=true; only these Nigerian numbers receive OTP codes in API responses.
DEMO_PHONE_ALLOWLIST=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
ESPEES_MERCHANT_WALLET=
ESPEES_API_TOKEN=
FRONTEND_URL=http://localhost:3000

# Staff alerts when a payment needs review or a provider is failing.
# Staff users get an in-app alert, an email (if their profile has one) and an SMS.
ADMIN_ALERT_EMAILS=
ADMIN_ALERT_SMS=1
# Real email: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the host details
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=edionwe.precious"stu.cu.edu.ng
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Netacess <alerts@yourdomain.com>
